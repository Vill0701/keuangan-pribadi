{
  "name": "keuangan-pribadi",
  "private": true,
  "description": "Pencatat keuangan pribadi: PWA + Google Apps Script + Google Sheets",
  "scripts": {
    "as:login": "clasp login",
    "as:create": "node scripts/create-apps-script.mjs",
    "as:push": "clasp push --force",
    "as:deploy": "clasp create-deployment --description \"Keuangan Pribadi\"",
    "as:deployments": "clasp list-deployments",
    "as:open": "clasp open-script",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
